# .env.nebius.example — Nebius × NVIDIA hackathon profile
# Same AI Order Agent, but the LLM runs on Nebius Token Factory (NVIDIA Nemotron).
# PayPal sandbox stays identical — dual entry from one codebase.

# --- PayPal (SANDBOX ONLY for this project) ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=<redacted>

# --- LLM: Nebius Token Factory (NVIDIA Nemotron) ---
# OpenAI-compatible: https://api.tokenfactory.nebius.com/v1  (Bearer auth)
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=<redacted>
# Model: nvidia/nemotron-3-nano-omni — copy the exact ID from the Token
# Factory playground before use; the playground copy governs if it differs.
LLM_MODEL=nvidia/nemotron-3-nano-omni

# --- App ---
FLASK_PORT=5000
